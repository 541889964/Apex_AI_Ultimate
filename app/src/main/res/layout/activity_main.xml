<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
        <!-- 顶栏 -->
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
            <ImageButton android:id="@+id/btnMenu" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_sort_by_size" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#00E5FF"/>
            <TextView android:id="@+id/btnModeAI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="智脑" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="18sp" android:layout_marginLeft="16dp"/>
            <TextView android:id="@+id/btnModeTerminal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="终端" android:textColor="#64748B" android:textSize="16sp" android:layout_marginLeft="16dp"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="就绪" android:textColor="#10B981" android:textSize="12sp" android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- AI 界面 -->
        <FrameLayout android:id="@+id/layoutAI" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/topBar" android:layout_above="@id/bottomArea">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChat" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp"/>
        </FrameLayout>

        <!-- 终端界面 -->
        <LinearLayout android:id="@+id/layoutTerminal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/topBar" android:layout_above="@id/bottomArea" android:orientation="vertical" android:visibility="gone" android:background="#000000">
            <ScrollView android:id="@+id/scrollTerm" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
                <TextView android:id="@+id/tvTerminal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#3FB950" android:fontFamily="monospace" android:textSize="13sp" android:text="Apex Terminal\n$ "/>
            </ScrollView>
        </LinearLayout>

        <!-- 底部输入区 -->
        <LinearLayout android:id="@+id/bottomArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_alignParentBottom="true" android:padding="12dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:background="@drawable/bg_capsule" android:gravity="center_vertical" android:paddingHorizontal="12dp">
                <ImageButton android:id="@+id/btnMic" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_btn_speak_now" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#64748B"/>
                <EditText android:id="@+id/etMsg" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:background="@null" android:hint="输入指令..." android:textColor="#FFF" android:textColorHint="#64748B" android:textSize="15sp"/>
            </LinearLayout>
            <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/btnSend" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginLeft="12dp" android:src="@android:drawable/ic_menu_send" app:backgroundTint="#00E5FF" app:tint="#000" app:elevation="8dp"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- 抽屉菜单 (全部功能) -->
    <LinearLayout android:layout_width="280dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#111827" android:orientation="vertical" android:padding="20dp" android:fitsSystemWindows="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apex 控制台" android:textSize="22sp" android:textStyle="bold" android:textColor="#00E5FF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DeepSeek API Key" android:layout_marginTop="20dp" android:textColor="#9CA3AF" android:textSize="12sp"/>
        <EditText android:id="@+id/etKey" android:layout_width="match_parent" android:layout_height="44dp" android:background="#1F2937" android:padding="8dp" android:textColor="#FFF" android:textSize="13sp" android:hint="输入密钥" android:textColorHint="#4B5563" android:layout_marginTop="4dp"/>
        <Button android:id="@+id/btnSaveKey" android:layout_width="match_parent" android:layout_height="40dp" android:text="保存" android:backgroundTint="#00E5FF" android:textColor="#000" android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="执行权限" android:layout_marginTop="16dp" android:textColor="#9CA3AF" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinnerMode" android:layout_width="match_parent" android:layout_height="40dp" android:background="#1F2937" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI 模型" android:layout_marginTop="12dp" android:textColor="#9CA3AF" android:textSize="12sp"/>
        <Spinner android:id="@+id/spinnerModel" android:layout_width="match_parent" android:layout_height="40dp" android:background="#1F2937" android:layout_marginTop="4dp"/>

        <Switch android:id="@+id/swSpeak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="语音播报" android:textColor="#FFF" android:checked="true" android:layout_marginTop="16dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#374151" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="极客快捷键" android:textColor="#00E5FF" android:textStyle="bold"/>
        <Button android:id="@+id/btnLogcat" android:layout_width="match_parent" android:layout_height="40dp" android:text="抓取崩溃日志" android:backgroundTint="#1F2937" android:textColor="#FFF" android:textSize="12sp" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnApps" android:layout_width="match_parent" android:layout_height="40dp" android:text="获取APP包名" android:backgroundTint="#1F2937" android:textColor="#FFF" android:textSize="12sp" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnClean" android:layout_width="match_parent" android:layout_height="40dp" android:text="清理系统缓存" android:backgroundTint="#1F2937" android:textColor="#FFF" android:textSize="12sp" android:layout_marginTop="8dp"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
